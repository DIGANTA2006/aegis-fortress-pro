# AEGIS PRO v2 â€“ Environment Template
# Copy to .env, fill in real values, then:
#   export $(grep -v '^#' .env | xargs)
#   python main.py

# ---- Data directory ----
AEGIS_DATA_DIR=/opt/aegis-data

# ---- Binance ----
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# ---- Bybit ----
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET=your_bybit_secret

# ---- OKX ----
OKX_API_KEY=your_okx_api_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase

# ---- Telegram Alerts ----
TG_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# ---- Mode: PAPER (default) or LIVE ----
AEGIS_MODE=PAPER

# ---- Required for LIVE mode (prevents accidental live trading) ----
# AEGIS_LIVE_CONFIRM=YES_I_ACCEPT_THE_RISK

# ---- Config file encryption password ----
AEGIS_CONFIG_PASSWORD=change_this_to_a_strong_password

# ---- Optional: HTTP proxy ----
# HTTP_PROXY=http://user:pass@host:port

