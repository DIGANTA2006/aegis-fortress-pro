# AEGIS FORTRESS PRO - paper/testnet-first low capital config
# Copy this file to .env and fill only the keys you actually use.

# Keep PAPER until you verify the bot for many days.
AEGIS_MODE=PAPER
AEGIS_LIVE_CONFIRM=

# Choose market data sources. Use binance,bybit for faster cross-exchange quotes.
AEGIS_ENABLED_EXCHANGES=binance,bybit
AEGIS_EXECUTION_EXCHANGES=binance

# Paper/testnet credentials. Do not paste live keys here unless AEGIS_MODE=LIVE and you accept the risk.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# Live credentials. Keep empty until ready. Create keys with SPOT trading only, no withdrawal permission.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET=
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_SECRET=

# Runtime universe. Only use symbols available on your selected exchange.
AEGIS_MARKET_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT,DOGE/USDT

# Speed knobs. Smaller interval = faster but more API rate-limit risk.
AEGIS_MARKET_POLL_INTERVAL_SECONDS=1.5
AEGIS_MARKET_FETCH_CONCURRENCY=8
AEGIS_ORDERBOOK_DEPTH=20
AEGIS_MARKET_STALE_AFTER_SECONDS=20

# Safety for very small capital. Values are USDT, not INR.
AEGIS_REFERENCE_EQUITY=15
AEGIS_MAX_GROSS_EXPOSURE=9
AEGIS_MAX_NET_EXPOSURE=9
AEGIS_MAX_SYMBOL_WEIGHT=1
AEGIS_MAX_ORDER_NOTIONAL=7.5
AEGIS_MAX_DAILY_LOSS=1.00
AEGIS_MAX_DRAWDOWN_PCT=8

# Existing low-risk live strategy exits. This exits open long positions automatically.
AEGIS_LIVE_STRATEGY_ENABLED=true
AEGIS_STRATEGY_ORDER_TYPE=MARKET
AEGIS_STRATEGY_TARGET_NOTIONAL=7.5
AEGIS_STRATEGY_MAX_POSITION_NOTIONAL=7.5
AEGIS_STRATEGY_MIN_ORDER_NOTIONAL=5.5
AEGIS_STRATEGY_TAKE_PROFIT_BPS=70
AEGIS_STRATEGY_STOP_LOSS_BPS=45
AEGIS_STRATEGY_MIN_PROFIT_AFTER_FEE_BPS=22
AEGIS_STRATEGY_TAKER_FEE_BPS=10
AEGIS_STRATEGY_SLIPPAGE_BPS=8
AEGIS_STRATEGY_PROFIT_BUFFER_BPS=5
AEGIS_STRATEGY_MAX_HOLD_SECONDS=900
AEGIS_STRATEGY_SYMBOL_COOLDOWN_AFTER_EXIT_SECONDS=1800
AEGIS_STRATEGY_LOSS_COOLDOWN_SECONDS=3600
AEGIS_BTC_FILTER_ENABLED=true
AEGIS_BTC_FILTER_REQUIRE_DATA=false
AEGIS_TRADE_BTC_SYMBOL=false

# Fortress trap scanner. It adds 15m support reclaim / pullback entries.
AEGIS_MOMENTUM_TRAP_ENABLED=true
AEGIS_MOMENTUM_TRAP_TIMEFRAME=15m
AEGIS_MOMENTUM_TRAP_INTERVAL_SECONDS=60
AEGIS_MOMENTUM_TRAP_CANDLE_LIMIT=90
AEGIS_MOMENTUM_TRAP_COOLDOWN_SECONDS=1800
AEGIS_MOMENTUM_TRAP_MAX_SPREAD_BPS=20
AEGIS_MOMENTUM_TRAP_RSI_MAX=68
AEGIS_MOMENTUM_TRAP_MIN_VOLUME_MULT=1.5
AEGIS_MOMENTUM_TRAP_PULLBACK_TOLERANCE_BPS=85

# Manual risk blocklist. Example: block tokens before major unlock/news risk.
AEGIS_SYMBOL_BLOCKLIST=RESOLV/USDT

# Local monitoring
AEGIS_HEALTH_HOST=127.0.0.1
AEGIS_HEALTH_PORT=8080
AEGIS_METRICS_PORT=9000
AEGIS_DATABASE_PATH=data/aegis_runtime.db
AEGIS_PORTFOLIO_STATE_PATH=data/portfolio_state.json
