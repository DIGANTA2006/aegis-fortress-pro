# ============================================================
# AEGIS v2 - Production/Local Environment Template
# Copy this file to .env and fill keys only in .env.
# ============================================================

# ----------------------------
# Risk capital model
# ----------------------------
AEGIS_REFERENCE_EQUITY=10000
AEGIS_MAX_GROSS_EXPOSURE=3000
AEGIS_MAX_NET_EXPOSURE=3000
AEGIS_MAX_SYMBOL_WEIGHT=1.00
AEGIS_MAX_ORDER_NOTIONAL=500
AEGIS_MAX_DAILY_LOSS=200
AEGIS_MAX_DRAWDOWN_PCT=10

# ----------------------------
# Market data
# ----------------------------
AEGIS_MARKET_SYMBOLS=BTC/USDT,ETH/USDT
AEGIS_MARKET_POLL_INTERVAL_SECONDS=2
AEGIS_ORDERBOOK_DEPTH=20
AEGIS_MARKET_STALE_AFTER_SECONDS=30

# ----------------------------
# Persistence
# ----------------------------
AEGIS_DATABASE_PATH=data/aegis_runtime.db

# ----------------------------
# Observability
# ----------------------------
AEGIS_LOG_LEVEL=INFO
AEGIS_METRICS_PORT=9000
AEGIS_MONITORING_INTERVAL_SECONDS=5

# ----------------------------
# Health server
# ----------------------------
AEGIS_HEALTH_HOST=127.0.0.1
AEGIS_HEALTH_PORT=8080
AEGIS_HEALTH_SNAPSHOT_INTERVAL_SECONDS=30

# ----------------------------
# Live strategy runtime
# Conservative testing defaults
# ----------------------------
AEGIS_LIVE_STRATEGY_ENABLED=true
AEGIS_STRATEGY_TARGET_NOTIONAL=100
AEGIS_STRATEGY_MAX_POSITION_NOTIONAL=300
AEGIS_STRATEGY_ROLLING_WINDOW=30
AEGIS_STRATEGY_MIN_OBSERVATIONS=20
AEGIS_STRATEGY_ENTRY_ZSCORE=0.75
AEGIS_STRATEGY_EXIT_ZSCORE=0.25
AEGIS_STRATEGY_IMBALANCE_THRESHOLD=0.08
AEGIS_STRATEGY_MAX_SPREAD_BPS=25
AEGIS_STRATEGY_COOLDOWN_SECONDS=15
AEGIS_STRATEGY_ORDER_TYPE=MARKET

# ----------------------------
# Trading execution mode
# PAPER = Testnet credential profiles
# LIVE  = real exchange credential profiles
# ----------------------------
AEGIS_MODE=PAPER
AEGIS_LIVE_CONFIRM=

# ----------------------------
# Binance Testnet credentials
# Used when AEGIS_MODE=PAPER
# ----------------------------
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET=

# ----------------------------
# Binance Live credentials
# Used when AEGIS_MODE=LIVE
# ----------------------------
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_SECRET=

# ----------------------------
# Bybit Testnet credentials
# Used when AEGIS_MODE=PAPER
# Optional. Leave blank to keep Bybit market-data-only.
# ----------------------------
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# ----------------------------
# Bybit Live credentials
# Used when AEGIS_MODE=LIVE
# Optional. Leave blank to keep Bybit execution disabled.
# ----------------------------
BYBIT_LIVE_API_KEY=
BYBIT_LIVE_SECRET=

# ----------------------------
# Internal selected credentials
# Do not edit these manually.
# scripts/load_env.ps1 sets them automatically.
# ----------------------------
BINANCE_API_KEY=
BINANCE_SECRET=
BYBIT_API_KEY=
BYBIT_SECRET=
